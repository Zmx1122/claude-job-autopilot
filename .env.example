# Copy to .env (Claude does this during setup). .env is git-ignored and never leaves your Mac.
# 复制为 .env（配置时 Claude 会帮你做）。.env 不会被提交到 git。
# Step-by-step: docs/credentials.md

# ---- Notion ----
# notion.so/profile/integrations → New integration → Internal → "Internal Integration Secret" (starts with ntn_)
NOTION_TOKEN=
# Link or id of the page that will hold the tracker (share it with the integration: ••• → Connections)
NOTION_PARENT_PAGE_ID=
# Filled in by tools/notion_setup.py
NOTION_DATABASE_ID=

# ---- Gmail (the inbox you apply with) ----
# 2-Step Verification on → myaccount.google.com/apppasswords → 16-letter app password
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
# Label added to every application email (created by tools/gmail_setup.py --create)
GMAIL_LABEL=applications

# ---- Dashboard ----
# Filled in when Claude creates the interactive dashboard artifact
DASHBOARD_URL=
