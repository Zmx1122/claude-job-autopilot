<mxfile host="build_diagram.py"><diagram name="Job Autopilot flow" id="flow"><mxGraphModel dx="1120" dy="1070" grid="1" gridSize="10" guides="1" page="1" pageWidth="1120" pageHeight="1070" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;1 · Set up once&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A867F&quot;&gt;一次性配置&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAF9F7;strokeColor=none;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="12" y="64" width="1096" height="288" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;2 · Every morning, automatic&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A867F&quot;&gt;每天早上 · 自动&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="12" y="364" width="1096" height="184" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3 · Apply session, with you&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A867F&quot;&gt;投递 · 你在场&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAF9F7;strokeColor=none;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="12" y="560" width="1096" height="376" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;4 · Every week&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8A867F&quot;&gt;每周&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F2EE;strokeColor=none;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1"><mxGeometry x="12" y="948" width="1096" height="92" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;You&lt;/b&gt; · 你" style="text;html=1;align=center;fontSize=15;fontColor=#7A4B00;" vertex="1" parent="1"><mxGeometry x="170" y="14" width="280" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Claude (desktop app)&lt;/b&gt; · Claude 桌面端" style="text;html=1;align=center;fontSize=15;fontColor=#7A3418;" vertex="1" parent="1"><mxGeometry x="510" y="14" width="320" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Services&lt;/b&gt; · 外部服务" style="text;html=1;align=center;fontSize=15;fontColor=#23426E;" vertex="1" parent="1"><mxGeometry x="890" y="14" width="220" height="30" as="geometry"/></mxCell><mxCell id="kb_u" value="&lt;b&gt;Drop documents (no CV is fine),&lt;br&gt;answer the questionnaire&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;上传材料（没有简历也行），回答问卷&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#E3A13B;strokeWidth=1.4;fontColor=#7A4B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="78" width="280" height="70" as="geometry"/></mxCell><mxCell id="kb_c" value="&lt;b&gt;Knowledge base, fact bank,&lt;br&gt;profile; first CV if needed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;建知识库、事实库与档案，必要时写简历&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="78" width="320" height="70" as="geometry"/></mxCell><mxCell id="cred_u" value="&lt;b&gt;Create Notion token +&lt;br&gt;Gmail app password&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;创建 Notion token 与 Gmail 应用密码&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#E3A13B;strokeWidth=1.4;fontColor=#7A4B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="173" width="280" height="70" as="geometry"/></mxCell><mxCell id="cred_c" value="&lt;b&gt;Create tracker database,&lt;br&gt;Gmail label &quot;applications&quot;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;建 Notion 表、Gmail 标签&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="173" width="320" height="70" as="geometry"/></mxCell><mxCell id="cred_s" value="&lt;b&gt;Notion · Gmail&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#5B7DB1;strokeWidth=1.4;fontColor=#23426E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="183" width="220" height="50" as="geometry"/></mxCell><mxCell id="login_u" value="&lt;b&gt;Log in to job sites in&lt;br&gt;Claude&#x27;s browser, allow uploads&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;在 Claude 浏览器登录各平台，开上传权限&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#E3A13B;strokeWidth=1.4;fontColor=#7A4B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="268" width="280" height="70" as="geometry"/></mxCell><mxCell id="login_c" value="&lt;b&gt;Check setup, schedule&lt;br&gt;daily + weekly tasks&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;检查配置，创建定时任务&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="268" width="320" height="70" as="geometry"/></mxCell><mxCell id="mail_c" value="&lt;b&gt;Mail sync: classify emails,&lt;br&gt;update status, add label&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;邮件同步：分类、更新状态、打标签&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="376" width="320" height="70" as="geometry"/></mxCell><mxCell id="mail_s" value="&lt;b&gt;Gmail → Notion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;确认信 · 面试 · 拒信&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#5B7DB1;strokeWidth=1.4;fontColor=#23426E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="386" width="220" height="50" as="geometry"/></mxCell><mxCell id="scan_c" value="&lt;b&gt;Scan · dedupe · filter,&lt;br&gt;tailored or template per job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;扫描去重筛选，逐个定精投 / 模版投&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="467" width="320" height="70" as="geometry"/></mxCell><mxCell id="scan_s" value="&lt;b&gt;LinkedIn · StepStone&lt;br&gt;Indeed · Xing&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#5B7DB1;strokeWidth=1.4;fontColor=#23426E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="471" width="220" height="62" as="geometry"/></mxCell><mxCell id="short_c" value="&lt;b&gt;Shortlist table in chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;聊天里给出精选岗位表&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="585" width="320" height="50" as="geometry"/></mxCell><mxCell id="pick_u" value="&lt;b&gt;Pick jobs  (&quot;1, 3, 5&quot;)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;选岗位，回答精投岗位的问题&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#E3A13B;strokeWidth=1.4;fontColor=#7A4B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="585" width="280" height="50" as="geometry"/></mxCell><mxCell id="fill_c" value="&lt;b&gt;Tailored CV + letter where it pays;&lt;br&gt;prefill each job, upload files&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;需要时写定制简历和求职信，逐个填到确认页&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="668" width="320" height="70" as="geometry"/></mxCell><mxCell id="hand_u" value="&lt;b&gt;CAPTCHA · account · missing file&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;验证码 / 注册 / 缺材料 → 你来&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#E3A13B;strokeWidth=1.4;fontColor=#7A4B00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="678" width="280" height="50" as="geometry"/></mxCell><mxCell id="ready_c" value="&lt;b&gt;Ready list&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;待提交清单&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="771" width="320" height="50" as="geometry"/></mxCell><mxCell id="ok_u" value="&lt;b&gt;Confirm once  ✓&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;确认一次&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F6EE;strokeColor=#2E9650;strokeWidth=2.4;fontColor=#145A2B;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="771" width="280" height="50" as="geometry"/></mxCell><mxCell id="send_c" value="&lt;b&gt;Submit all, log each row&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;全部提交并逐条记录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="861" width="320" height="50" as="geometry"/></mxCell><mxCell id="send_s" value="&lt;b&gt;Platforms + company portals&lt;br&gt;Notion tracker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;平台与公司官网 · Notion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#5B7DB1;strokeWidth=1.4;fontColor=#23426E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="851" width="220" height="70" as="geometry"/></mxCell><mxCell id="dash_c" value="&lt;b&gt;Refresh Notion charts +&lt;br&gt;interactive dashboard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6F6B64&quot;&gt;刷新 Notion 图表与交互看板&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBEDE6;strokeColor=#D97757;strokeWidth=1.4;fontColor=#7A3418;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510" y="959" width="320" height="70" as="geometry"/></mxCell><mxCell id="dash_s" value="&lt;b&gt;Notion page · claude.ai&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3FA;strokeColor=#5B7DB1;strokeWidth=1.4;fontColor=#23426E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="890" y="969" width="220" height="50" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6862;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="kb_u" target="kb_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6862;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="cred_u" target="cred_c"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6862;strokeWidth=1.6;endArrow=block;endFill=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="cred_c" target="cred_s"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6B6862;strokeWidth=1.6;endArrow=block;endFill=1;fontSize